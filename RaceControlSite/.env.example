# All optional — the site builds and links correctly with sensible defaults
# (see src/lib/config.ts) even if none of these are set.

# Public production backend (defaults to https://racecontrol.owl-media.co.uk).
NEXT_PUBLIC_BACKEND_API_URL=https://racecontrol.owl-media.co.uk

# The Next.js web client (RaceControlWeb), once deployed.
NEXT_PUBLIC_WEB_APP_URL=https://web.getracecontrol.com

# Set these once the apps are published; until then the site shows a
# "Coming soon" badge instead of a store link.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
