# Human-edited dependency spec: direct dependencies only, as floors/ceilings.
# Python 3.10+ for local development; the lock is compiled for Python 3.12.
#
# requirements.txt is compiled from this file by pip-compile (pip-tools) and
# pins every direct and transitive dependency to an exact version. CI and the
# production image install requirements.txt; never edit it by hand.
#
# After changing this file, recompile against python:3.12-slim (the exact base
# image in Dockerfile) and commit both files together:
#     docker run --rm -v "$PWD:/src" -w /src python:3.12-slim sh -c \
#       "pip install -q pip-tools && pip-compile --strip-extras --output-file=requirements.txt requirements.in"
# Existing pins are kept unless this file forces a change. Add
# `--upgrade-package <name>` to bump one dependency, or `--upgrade` for all.
# Dependabot (see .github/dependabot.yml) runs the same compile for its
# weekly update PR, so the lock it proposes is always a resolvable set.

# fastf1 pulls pandas/numpy/scipy/matplotlib itself.
fastf1>=3.5,<4.0
fastapi>=0.142.2
uvicorn[standard]>=0.54.0

