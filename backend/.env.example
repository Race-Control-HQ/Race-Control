# Copy to .env for local use, or set these as environment variables in Coolify.

# ---------------------------------------------------------------------------
# AUTHENTICATION
# Any one of the three mechanisms below authorises an /api request. They are
# independent — enabling Play Integrity for Android doesn't require or affect
# App Attest for iOS, and vice versa. If ALL THREE are empty/disabled the API
# is fully open (fine for local dev with ./run.sh).
# ---------------------------------------------------------------------------

# 1) App Attest — how the published iOS app authenticates with no user key.
#    Enable this for an App Store build.
APP_ATTEST_ENABLED=false
APPLE_TEAM_ID=            # 10-char Team ID from developer.apple.com
APP_BUNDLE_ID=com.owlmedia.racecontrol
APP_ATTEST_PRODUCTION=false   # false = Apple "development" env (Xcode debug builds)
JWT_SECRET=              # openssl rand -hex 32  (signs app tokens)
JWT_TTL_SECONDS=86400    # app token lifetime (24h); app auto-refreshes via assertion
# ATTEST_DB=/data/attest_keys.sqlite   # where attested keys are persisted

# 2) Play Integrity — how the published Android app authenticates with no user
#    key. Enable this for a Play Store build. Requires, from Google Cloud +
#    Play Console (none of this can be set up from code):
#      - A Google Cloud project with the "Play Integrity API" enabled.
#      - That project linked to the app in Play Console (Setup > API access).
#      - A service account in that project, granted access to the linked app
#        via Play Console, with a JSON key downloaded.
#      - The app's package name and (recommended) release signing cert SHA-256
#        digest, from Play Console > Setup > App signing.
PLAY_INTEGRITY_ENABLED=false
ANDROID_PACKAGE_NAME=com.owlmedia.racecontrol
GOOGLE_CLOUD_PROJECT_NUMBER=          # numeric project number, linked in Play Console
# Paste the service-account JSON key inline (one line), or use
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json instead.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/data/play-integrity-service-account.json
# Optional but recommended: comma-separated SHA-256 digest(s) of the app's
# signing certificate(s) (Play Console > Setup > App signing). Pins against a
# resigned/repackaged APK even if it somehow passed the other checks.
ANDROID_SIGNING_CERT_SHA256=
# Weakest deviceIntegrity.deviceRecognitionVerdict accepted. Real Play Store
# installs on real hardware report MEETS_DEVICE_INTEGRITY; only relax this to
# MEETS_BASIC_INTEGRITY temporarily, for testing on an emulator/rooted device
# before the app is actually live on Play.
PLAY_INTEGRITY_MIN_DEVICE_VERDICT=MEETS_DEVICE_INTEGRITY
# Accept an UNEVALUATED app/device verdict (what you get from an internal
# testing track build, or before the app has enough Play install history).
# Leave false for production; true only while bringing up a new release.
PLAY_INTEGRITY_ALLOW_UNEVALUATED=false

# 3) Shared-secret admin/break-glass token (optional). Also handy for curl.
#    Generate one with:  openssl rand -hex 32
API_TOKEN=

# Per-IP rate limit (requests/minute; 0 disables). Defence in depth.
RATE_LIMIT_PER_MINUTE=120

# Where FastF1 caches downloaded timing/telemetry data.
# In Docker this defaults to /data/fastf1_cache — mount a persistent volume there.
# FASTF1_CACHE=/data/fastf1_cache

# Port the API listens on (Coolify sets this automatically).
PORT=8000

# Uvicorn workers. Each worker keeps its OWN response/session/points-progression
# caches, with no sharing between them — main.py refuses to start above 1 until
# those caches are externalized to a shared store. Do not raise this.
WEB_CONCURRENCY=1

# How many FastF1 sessions to hold in memory. Lower this on a small container
# (each loaded race session with telemetry can be tens of MB).
SESSION_CACHE_MAX=48

# Response cache lifetime in seconds (historical data barely changes).
CACHE_TTL_SECONDS=21600

# Comma-separated browser origins allowed via CORS (e.g. https://app.example.com).
# Empty/unset denies all browser origins. Native iOS/Android clients are
# unaffected (they never send an Origin header), and RaceControlWeb proxies
# through its own Next.js server rather than calling this API from the browser,
# so this should normally stay empty.
ALLOWED_ORIGINS=
