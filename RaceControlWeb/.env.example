# Copy to .env.local for local development.

# Base URL of the RaceControl backend API (see ../backend).
# Local dev against `./run.sh`:
RACECONTROL_API_BASE_URL=http://localhost:8000

# Bearer token sent to the backend's API_TOKEN admin/dev auth mechanism.
# Leave empty for a local backend with no auth configured.
# In production, set this to the same value as the backend's API_TOKEN env var.
RACECONTROL_API_TOKEN=

# Port the web app listens on (Coolify sets this automatically).
PORT=3000
